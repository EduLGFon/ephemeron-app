# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
pubspec.lock

# Generated code (Drift/Riverpod codegen) — regenerate via build_runner,
# don't commit
*.g.dart
*.freezed.dart

# IDE
.idea/
.vscode/
*.iml

# Platform build artifacts
# ios/Pods/
ios/
# Critical Alerts entitlement is hand-written source, not regenerable
# scaffolding: keep it versioned like the Android alarm module.
!app/ios/
app/ios/*
!app/ios/Runner/
app/ios/Runner/*
!app/ios/Runner/Runner.entitlements
android/
# Ephemeron native alarm module is hand-written source, not regenerable
# scaffolding: keep it versioned so `flutter create` regens can't silently
# drop it. Ladder re-includes only the manifest (receiver declarations),
# the two alarm files, and MainActivity (permission bridge for
# notifications/full-screen intent/app settings); everything else under
# android/ stays ignored.
!app/android/
app/android/*
!app/android/app/
app/android/app/*
!app/android/app/src/
app/android/app/src/*
!app/android/app/src/main/
app/android/app/src/main/*
!app/android/app/src/main/AndroidManifest.xml
!app/android/app/src/main/kotlin/
app/android/app/src/main/kotlin/*
!app/android/app/src/main/kotlin/com/
app/android/app/src/main/kotlin/com/*
!app/android/app/src/main/kotlin/com/spotnik/
app/android/app/src/main/kotlin/com/spotnik/*
!app/android/app/src/main/kotlin/com/spotnik/ephemeron/
app/android/app/src/main/kotlin/com/spotnik/ephemeron/*
!app/android/app/src/main/kotlin/com/spotnik/ephemeron/AlarmPlugin.kt
!app/android/app/src/main/kotlin/com/spotnik/ephemeron/AlarmStore.kt
!app/android/app/src/main/kotlin/com/spotnik/ephemeron/AlarmReceiver.kt
!app/android/app/src/main/kotlin/com/spotnik/ephemeron/AlarmRingService.kt
!app/android/app/src/main/kotlin/com/spotnik/ephemeron/MainActivity.kt
# Widget source is hand-written (not regenerable); keep it versioned.
!app/android/app/src/main/kotlin/com/spotnik/ephemeron/HomeWidgets.kt
!app/android/app/src/main/kotlin/com/spotnik/ephemeron/CollectionWidgets.kt
!app/android/app/src/main/kotlin/com/spotnik/ephemeron/WeekCalendarWidget.kt
!app/android/app/src/main/res/
app/android/app/src/main/res/*
!app/android/app/src/main/res/layout/
app/android/app/src/main/res/layout/*
!app/android/app/src/main/res/layout/ephemeron_widget.xml
!app/android/app/src/main/res/layout/ephemeron_week_calendar_widget.xml
!app/android/app/src/main/res/layout/ephemeron_collection_widget.xml
!app/android/app/src/main/res/layout/ephemeron_collection_item.xml
!app/android/app/src/main/res/xml/
app/android/app/src/main/res/xml/*
!app/android/app/src/main/res/xml/ephemeron_widget_info.xml
!app/android/app/src/main/res/xml/ephemeron_week_calendar_widget_info.xml
!app/android/app/src/main/res/xml/shortcuts.xml
!app/android/app/src/main/res/values/
app/android/app/src/main/res/values/*
!app/android/app/src/main/res/values/strings.xml
